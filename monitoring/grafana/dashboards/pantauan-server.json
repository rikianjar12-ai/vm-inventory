            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": " (   count(     (       (max by (instance) (100 * (1 - avg by (instance) (rate(node_cpu_seconds_total{mode=\"idle\",job=\"node\"}[5m]))) > 85))       or       (max by (instance) (100 * (1 - node_memory_MemAvailable_bytes{job=\"node\"} / node_memory_MemTotal_bytes{job=\"node\"}) > 90))       or       (max by (instance) (100 - (100 * node_filesystem_avail_bytes{job=\"node\",fstype!~\"tmpfs|overlay|squashfs|devtmpfs\",mountpoint!~\"/boot|/boot/efi\"} / node_filesystem_size_bytes{job=\"node\",fstype!~\"tmpfs|overlay|squashfs|devtmpfs\",mountpoint!~\"/boot|/boot/efi\"}) > 85))     )     and on (instance) (up{job=\"node\"} == 1)   )   or vector(0) ) + (   count(     (       (max by (instance) (100 * (1 - avg by (instance) (rate(windows_cpu_time_total{mode=\"idle\",job=\"windows\"}[5m]))) > 85))       or       (max by (instance) (100 * (1 - windows_memory_available_bytes{job=\"windows\"} / windows_cs_physical_memory_bytes{job=\"windows\"}) > 90))       or       (max by (instance) (100 - (100 * windows_logical_disk_free_bytes{job=\"windows\",volume=~\"[A-Z]:\"} / windows_logical_disk_size_bytes{job=\"windows\",volume=~\"[A-Z]:\"}) > 85))     )     and on (instance) (up{job=\"windows\"} == 1)   )   or vector(0) ) ",
          "legendFormat": "High",
          "refId": "A",
          "instant": true,
          "format": "time_series"

    {
      "type": "table",
      "title": "Server Health Status",
      "description": "UP=1 online. High: CPU > 85, RAM > 90, disk > 85. Critical: disk > 95, server/service down.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 14
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "up{job=~\"node|windows\",server_id=~\"$server\"}",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "max by (instance, server_id, application, lokasi) ((100 * (1 - avg by (instance, server_id, application, lokasi) (rate(node_cpu_seconds_total{mode=\"idle\",server_id=~\"$server\"}[5m])))) or (100 * (1 - avg by (instance, server_id, application, lokasi) (rate(windows_cpu_time_total{mode=\"idle\",server_id=~\"$server\"}[5m])))))",
          "legendFormat": "",
          "refId": "C",
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "max by (instance, server_id, application, lokasi) ((100 * (1 - node_memory_MemAvailable_bytes{server_id=~\"$server\"} / node_memory_MemTotal_bytes{server_id=~\"$server\"})) or (100 * (1 - windows_memory_available_bytes{server_id=~\"$server\"} / windows_cs_physical_memory_bytes{server_id=~\"$server\"})))",
          "legendFormat": "",
          "refId": "B",
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "max by (instance, server_id, application, lokasi) ((100 - (100 * node_filesystem_avail_bytes{fstype!~\"tmpfs|overlay|squashfs|devtmpfs\",mountpoint!~\"/boot|/boot/efi\",server_id=~\"$server\"} / node_filesystem_size_bytes{fstype!~\"tmpfs|overlay|squashfs|devtmpfs\",mountpoint!~\"/boot|/boot/efi\",server_id=~\"$server\"})) or (100 - (100 * windows_logical_disk_free_bytes{volume=~\"[A-Z]:\",server_id=~\"$server\"} / windows_logical_disk_size_bytes{volume=~\"[A-Z]:\",server_id=~\"$server\"})))",
          "legendFormat": "",
          "refId": "D",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },

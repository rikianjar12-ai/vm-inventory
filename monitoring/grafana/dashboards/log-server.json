{
  "annotations": { "list": [] },
  "description": "Syslog, login (auth/ssh), dan log service (systemd) via Loki.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [
    {
      "asDropdown": false,
      "icon": "dashboard",
      "includeVars": true,
      "keepTime": true,
      "targetBlank": false,
      "title": "Data Center Overview",
      "tooltip": "Ringkasan kesehatan server",
      "type": "link",
      "url": "/d/lrt-server-health/data-center-overview"
    }
  ],
  "liveNow": true,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "title": "Ringkasan log",
      "type": "row"
    },
    {
      "datasource": { "type": "loki", "uid": "loki" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 8, "x": 0, "y": 1 },
      "id": 2,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["sum"], "fields": "", "values": false },
        "textMode": "value_and_name"
      },
      "pluginVersion": "11.2.2",
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "sum(count_over_time({server_id=~\"$server\"}[1h]))",
          "legendFormat": "Baris / 1 jam",
          "refId": "A"
        }
      ],
      "title": "Volume log",
      "type": "stat"
    },
    {
      "datasource": { "type": "loki", "uid": "loki" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 8, "x": 8, "y": 1 },
      "id": 3,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["sum"], "fields": "", "values": false },
        "textMode": "value_and_name"
      },
      "pluginVersion": "11.2.2",
      "targets": [
        {
          "expr": "sum(count_over_time({server_id=~\"$server\"} |~ \"(?i)(failed password|invalid user|authentication failure)\" [1h]))",
          "legendFormat": "Login gagal / 1 jam",
          "refId": "A"
        }
      ],
      "title": "Login gagal",
      "type": "stat"
    },
    {
      "datasource": { "type": "loki", "uid": "loki" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 8, "x": 16, "y": 1 },
      "id": 4,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["sum"], "fields": "", "values": false },
        "textMode": "value_and_name"
      },
      "pluginVersion": "11.2.2",
      "targets": [
        {
          "expr": "sum(count_over_time({server_id=~\"$server\"} |~ \"(?i)(error|fatal|failed)\" [1h]))",
          "legendFormat": "Error / 1 jam",
          "refId": "A"
        }
      ],
      "title": "Baris error",
      "type": "stat"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "id": 5,
      "title": "Login log (auth / ssh / sudo)",
      "type": "row"
    },
    {
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 6 },
      "id": 6,
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showLabels": false,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "{server_id=~\"$server\"} |~ \"(?i)(sshd|sudo|systemd-logind|session|password|accepted|failed)\"",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "Login & otorisasi",
      "type": "logs"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 18 },
      "id": 7,
      "title": "Syslog",
      "type": "row"
    },
    {
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 19 },
      "id": 8,
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "expr": "{server_id=~\"$server\", job=~\"syslog|systemd\"}",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "Syslog / journal",
      "type": "logs"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 31 },
      "id": 9,
      "title": "Service log",
      "type": "row"
    },
    {
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 32 },
      "id": 10,
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "showLabels": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "expr": "{server_id=~\"$server\", job=\"systemd\", unit=~\"$unit\"}",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "Log unit systemd",
      "type": "logs"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["lrt", "loki", "syslog", "auth"],
  "templating": {
    "list": [
      {
        "current": { "selected": true, "text": "All", "value": "$__all" },
        "datasource": { "type": "loki", "uid": "loki" },
        "definition": "label_values(server_id)",
        "includeAll": true,
        "label": "Server",
        "multi": true,
        "name": "server",
        "query": "label_values(server_id)",
        "refresh": 2,
        "sort": 1,
        "type": "query"
      },
      {
        "current": { "selected": true, "text": "All", "value": "$__all" },
        "datasource": { "type": "loki", "uid": "loki" },
        "definition": "label_values({server_id=~\"$server\", job=\"systemd\"}, unit)",
        "includeAll": true,
        "label": "Service",
        "multi": true,
        "name": "unit",
        "query": "label_values({server_id=~\"$server\", job=\"systemd\"}, unit)",
        "refresh": 2,
        "sort": 1,
        "type": "query"
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "timezone": "Asia/Jakarta",
  "title": "04 Centralized Logs",
